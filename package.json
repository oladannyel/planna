{
  "name": "planna",
  "version": "1.1.0",
  "private": true,
  "description": "A to-do list that talks back: write one sentence about your day and plAnna turns it into a tracked Kanban board, then shows you where your attention actually went.",
  "license": "MIT",
  "author": "Daniel Olaniyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oladannyel/planna.git"
  },
  "bugs": {
    "url": "https://github.com/oladannyel/planna/issues"
  },
  "homepage": "https://github.com/oladannyel/planna#readme",
  "keywords": [
    "productivity",
    "task-management",
    "kanban",
    "nextjs",
    "supabase",
    "typescript",
    "self-hosted",
    "personal-analytics",
    "ai",
    "openrouter"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "openai": "^7.52.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.0.7",
    "msw": "^2.14.6",
    "pg": "^8.21.0",
    "postcss": "^8",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "source-map-js": ">=1.2.2"
    }
  }
}
