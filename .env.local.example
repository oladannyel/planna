# ─── Supabase ─────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then find these under
# Project Settings → API.

# Your project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The "anon" / public key. Safe to expose to the browser — Row Level Security
# is what protects your data, not this key's secrecy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key. SERVER ONLY. This key BYPASSES Row Level Security.
# Never prefix it with NEXT_PUBLIC_, never log it, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres connection string, used only by the one-off
# migration runner in scripts/. Project Settings → Database → Connection string.
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ─── Model provider ───────────────────────────────────────────────────────────
# Any OpenAI-compatible chat-completions API. plAnna uses no vendor-specific
# feature — no JSON mode, no tool calling — so OpenRouter, OpenAI, Groq,
# Together, Fireworks and a local Ollama / vLLM server all work unchanged.
#
# OpenRouter is the default because its free tier makes plAnna free to run.
# Get a key at https://openrouter.ai/keys.
AI_API_KEY=your-api-key
AI_BASE_URL=https://openrouter.ai/api/v1

# AI_MODEL       — parses your notes into tasks.
# AI_REPORT_MODEL — writes the weekly and monthly narratives.
#
# These are variables rather than hardcoded values because free-tier models are
# retired often. If parsing starts failing, check which is the case first:
#   • HTTP 404 → the model no longer exists. Pick a new one from
#     https://openrouter.ai/models?max_price=0 and update both values.
#   • HTTP 429 → you hit the free daily request cap, not a dead model.
#   • HTTP 401 → the key itself is revoked. Every model will look dead; no
#     amount of swapping slugs will help. Issue a new key.
#
# The daily cron at /api/cron/ai-health makes all three distinctions for you.
#
# Other providers, for reference:
#   OpenAI  AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini
#   Groq    AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=llama-3.3-70b-versatile
#   Ollama  AI_BASE_URL=http://localhost:11434/v1      AI_MODEL=llama3.1
AI_MODEL=openrouter/free
AI_REPORT_MODEL=openrouter/free

# Optional failover. A comma-separated list of models to try, in order, when
# the configured one fails in a way another model could fix: retired (404),
# daily cap reached (429), or backend unwell (5xx). A rejected key (401) and a
# malformed request (400) are never retried — every model shares the one key
# and the one request, so a second attempt is a guaranteed second failure.
#
# This happens per request and needs no redeploy, so a model dying at 03:00
# costs you nothing. Empty by default: silently answering with a model you did
# not choose should be something you opted into.
#
# Pick models that can follow a plain "reply with JSON" instruction; plAnna
# uses no vendor-specific feature, so anything on your provider works.
#
# No slugs are suggested here on purpose. Free models are retired weekly, so
# any example committed to a file is wrong within the month — this one already
# shipped two dead slugs. List what is actually live instead:
#
#   curl -s https://openrouter.ai/api/v1/models \
#     | jq -r '.data[] | select(.pricing.prompt == "0") | .id'
#
# Then set the chain and let the health check confirm it:
#
#   curl -H "Authorization: Bearer $CRON_SECRET" localhost:3000/api/cron/ai-health
#
# It probes every model in the chain and names the dead ones, which is the
# whole reason it probes the fallbacks and not just the primary.
# AI_MODEL_FALLBACKS=

# The previous names OPENROUTER_API_KEY / OPENROUTER_BASE_URL /
# OPENROUTER_FREE_MODEL / OPENROUTER_REPORT_MODEL are still accepted as a
# fallback, so an existing deployment keeps working without changes.

# ─── App ──────────────────────────────────────────────────────────────────────
# The app's own base URL. Must match the redirect URL you register under
# Supabase → Authentication → Providers → Google.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Shared secret for the scheduled OpenRouter health check (see vercel.json).
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
#
# Generate one with:  openssl rand -hex 32
#
# Required in any environment where the cron runs: without it the route
# refuses to run rather than leave an endpoint open that spends API quota.
CRON_SECRET=your-cron-secret
